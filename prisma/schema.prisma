generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lead {
  id            String        @id @default(uuid())
  name          String?
  phone         String        @unique
  stage         String        @default("Novos")
  status        String        @default("new")
  treatment     String?
  botStep       String        @default("start")
  botData       Json          @default("{}")
  lastMessageAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  followups     Followup[]
  appointments  Appointment[]
  messages      Message[]

  @@index([phone])
  @@index([stage])
  @@index([lastMessageAt])
}

model Message {
  id        String   @id @default(uuid())
  leadId    String
  from      String
  text      String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
}

model Followup {
  id        String    @id @default(uuid())
  leadId    String
  runAt     DateTime
  status    String    @default("pending")
  message   String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([runAt])
  @@index([status])
}

model Appointment {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title       String
  scheduledAt DateTime
  duration    Int      @default(30)
  status      String   @default("confirmed")
  notes       String?
  createdAt   DateTime @default(now())
}

model BatchDispatch {
  id         String              @id @default(uuid())
  name       String
  message    String
  totalLeads Int                 @default(0)
  sentCount  Int                 @default(0)
  failCount  Int                 @default(0)
  status     String              @default("pending")
  createdAt  DateTime            @default(now())
  items      BatchDispatchItem[]
}

model BatchDispatchItem {
  id      String        @id @default(uuid())
  batchId String
  batch   BatchDispatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  phone   String
  name    String?
  status  String        @default("pending")
  sentAt  DateTime?
  error   String?
}

model Config {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
